<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="d-flex flex-column flex-md-row">
        <div class="text-center text-md-left flex-shrink-0" style="min-width: 140px">
          {% if content.date %} {% assign date = content.date | split: '-' | join: '.' %} {% else %} {% assign date = '' %} {% endif %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle"> {{ date }} </span>
        </div>
        <div class="flex-grow-1 mt-2 mt-md-0 ml-md-3">
          <h6 class="title font-weight-bold">
            <a href="{{ content.url }}">{{ content.title }}</a>
          </h6>
          <h6 style="font-size: 0.95rem">{{ content.awarder }}</h6>
          <h6 style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
